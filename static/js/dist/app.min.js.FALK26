document.addEventListener("keydown", function(e) {
  if (e.key === "Escape") {
    window.closeFalkMenu();
  if (e.key === "Enter" && !e.shiftKey) {
    const target = e.target;
    if (target && (target.tagName === "TEXTAREA" || target.tagName === "INPUT")) {
      e.preventDefault();
      window.sendMessage();
  }
}, true);

